# Auth.js secret - generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PostgreSQL database URL
DATABASE_URL="postgresql://user:password@localhost:5432/difyon?schema=public"

# Public app URL (used for email verification links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email sender address
EMAIL_FROM="noreply@example.com"

# Resend API key for production email delivery
RESEND_API_KEY=

# Optional Cloudflare Turnstile keys for challenge-on-abuse protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
